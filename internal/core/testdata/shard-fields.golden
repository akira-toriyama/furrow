# The on-disk shape of every furrow shard. See TestShardFieldsGolden.
# Changing this file means changing what other furrows read.
schema_version 8

Task
  id string
  title string
  status string
  priority int
  value *int (omitempty)
  effort *int (omitempty)
  labels []string
  repos []string
  deps []string
  refs []string
  checklist []core.ChecklistItem
  created time.Time
  updated time.Time
  closed *time.Time
  reviewed *time.Time
  body string
  epic string (omitempty)
  due *time.Time (omitempty)

Meta
  schema_version int

RepoRecord
  repo string
  last_reviewed *time.Time
  last_agent_reviewed *time.Time

Epic
  id string
  title string
  goal string
  active bool
  labels []string
  repos []string
  meta map[string]string
  created time.Time
  updated time.Time
  closed *time.Time
  body string
  deps []string
  standing bool
  pinned bool

ChecklistItem
  text string
  done bool
