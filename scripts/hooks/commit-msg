#!/bin/sh
# commit-msg hook: check the message against the gitmoji convention.
# Enable:     git config core.hooksPath scripts/hooks
# Convention: https://github.com/akira-toriyama/.github/blob/main/CONTRIBUTING.md
#
# The grammar is NOT written here. `glyph` is the fleet's machine-readable canon
# for it (`glyph rules`), and `glyph lint --stdin` is its documented
# authoring-time entry point — the same checker CI runs over the range, so a
# message this hook accepts is one CI accepts.
#
# A second copy of the pattern is exactly what went wrong: this hook hard-coded
# the retired `<:gitmoji:> <type>(<scope>): <subject>` form and stayed that way
# after the convention moved to `<:gitmoji:>[(<scope>)][!] <subject>`, so
# enabling it — which CLAUDE.md tells contributors to do — rejected every commit
# on this repo's own main branch. Delegation is the fix: there is no longer a
# copy that can drift.
#
# glyph also owns the cases a hand-rolled pattern gets wrong: merge, revert,
# fixup!/squash!, and `:construction:` (legal while authoring, a violation on the
# way into main).

if ! command -v glyph >/dev/null 2>&1; then
	echo "commit-msg: glyph is not on PATH — convention check SKIPPED (CI still lints the range)." >&2
	exit 0
fi

exec glyph lint --stdin <"$1"
